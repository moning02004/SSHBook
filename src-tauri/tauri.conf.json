{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHBook",
  "version": "1.0.1",
  "identifier": "com.moning02004.sshbook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSHBook",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "SSH·로컬 터미널, 세션 보관함",
    "publisher": "moning02004",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCOTY2QjUxMzRGNDQyNTUKUldSVlF2UTBVV3VXSzNjb280TEZWZjFJdGdkTEhSMjNhTS92dTRIV3Jkd25MWlR3aEtXNEFqY2MK",
      "endpoints": [
        "https://github.com/moning02004/SSHBook/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
